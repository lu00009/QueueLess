# QueueLess Backend Production Environment Template
PORT=5000
NODE_ENV=production

# Database Connection (Neon PostgreSQL or self-hosted PostgreSQL)
# Example Neon: postgresql://<user>:<password>@<neon-subdomain>.neon.tech/queueless?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/queueless_db?schema=public

# Security Tokens (Generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=your-32-character-production-access-token-secret-key-here
JWT_REFRESH_SECRET=your-32-character-production-refresh-token-secret-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:80,http://localhost:3000,http://localhost:5173

# Firebase Cloud Messaging (Push Notifications)
# FIREBASE_PROJECT_ID=queueless-prod
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@queueless-prod.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
